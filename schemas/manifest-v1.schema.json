{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","batch_id","person_count","created_at","files"],
  "properties":{
    "schema_version":{"type":"integer","const":1},
    "batch_id":{"type":"string","minLength":1},
    "person_count":{"type":"integer","minimum":1,"maximum":1000},
    "created_at":{"type":"string","format":"date-time","pattern":"Z$"},
    "files":{"type":"array","minItems":4,"items":{
      "type":"object","additionalProperties":false,"required":["path","size_bytes","sha256"],
      "properties":{"path":{"type":"string","minLength":1},"size_bytes":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
    }}
  }
}
